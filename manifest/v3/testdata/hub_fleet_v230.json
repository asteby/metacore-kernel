        },
        {
          "name": "notes",
          "type": "text",
          "label": "hub_fleet.field.notes",
          "widget": "textarea",
          "visibility": "modal"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "label": "hub_fleet.field.created_at",
          "visibility": "list"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "label": "hub_fleet.field.updated_at",
          "visibility": "list"
        },
        {
          "name": "deleted_at",
          "type": "timestamp",
          "label": "hub_fleet.field.deleted_at",
          "visibility": "list"
        },
        {
          "name": "retired_at",
          "type": "timestamptz",
          "protected": true
        },
        {
          "name": "retired_by_id",
          "type": "uuid",
          "protected": true
        },
        {
          "name": "retired_reason",
          "type": "text",
          "protected": true
        }
      ],
      "indices": [
        {
          "name": "hub_fleet_instances_org_instance_uq",
          "columns": [
            "organization_id",
            "instance_id"
          ],
          "unique": true,
          "where": "deleted_at IS NULL"
        }
      ],
      "seed": {
