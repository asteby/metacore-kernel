            },
            {
              "value": "none",
              "label": "hub_fleet.license.none",
              "color": "gray"
            }
          ],
          "protected": true
        },
        {
          "name": "last_seen_at",
          "type": "timestamp",
          "label": "hub_fleet.field.last_seen_at",
          "display": "date",
          "protected": true
