      "reason_required": {
        "actions": [
          "retire",
          "request_revoke"
        ],
        "min_length": 3
      },
      "ingest": {
        "key": [
          "instance_id"
        ],
        "cursor": "source_seq",
        "fields": [
          "name",
          "customer",
          "brand_name",
          "brand_color",
          "vertical",
          "deployment",
          "environment",
          "channel",
          "reported_version",
          "license_status",
          "last_seen_at",
          "source_seq"
        ],
        "exclusive": true,
        "on_delete": "soft",
        "max_batch": 500
      }
    }
  ],
  "contributions": {
    "navigation": [
      {
        "title": "hub_fleet.nav.group",
        "icon": "Server",
        "target": "sidebar.operations",
        "items": [
          {
            "title": "hub_fleet.nav.instances",
            "icon": "Server",
            "model": "Instance",
            "permission": "hub_fleet.instance.read"
          }
        ]
      }
    ],
    "actions": [
      {
        "key": "request_revoke",
        "label": "hub_fleet.action.request_revoke",
        "icon": "ShieldOff",
        "target_model": "Instance",
        "placement": "row",
        "confirm": true,
        "confirm_message": "hub_fleet.action.request_revoke_confirm",
        "requires_state": [
          "active"
        ],
        "fields": [
          {
            "key": "reason",
            "label": "hub_fleet.action.fields.reason",
            "type": "string",
            "widget": "textarea",
            "required": true
          }
        ],
        "handler": {
          "type": "webhook",
          "url_ref": "trust_core.base_url",
          "path": "/core/v1/fleet/instances/{record.instance_id}/revoke-request",
          "method": "POST",
          "signing": {
            "scheme": "metacore-hmac-v1",
            "secret_ref": "trust_core.signing_secret"
          },
          "send_record": [
            "instance_id",
            "license_status"
          ],
          "timeout_ms": 10000,
          "retries": 2,
          "on_success": {
            "set": {
              "license_status": "revoke_requested"
            }
          }
        },
        "tone": "danger",
        "confirm_typed": {
          "field": "name"
        }
      },
      {
        "key": "retire",
        "label": "hub_fleet.action.retire",
        "icon": "Archive",
        "target_model": "Instance",
        "placement": "row",
        "tone": "danger",
        "requires_state": [
          "active"
        ],
        "confirm": true,
        "confirm_message": "hub_fleet.action.retire_impact",
        "confirm_typed": {
          "field": "name"
        },
        "fields": [
          {
            "key": "reason",
            "type": "string",
            "widget": "textarea",
            "required": true
          }
        ],
        "handler": {
          "type": "set_fields",
          "set": {
            "status": "retired",
            "retired_at": "$now",
            "retired_by_id": "$actor.id",
            "retired_reason": "$payload.reason"
          }
        }
      }
    ],
    "dashboard": [
      {
        "key": "instances_online",
        "title": "hub_fleet.kpi.online",
        "kind": "stat",
        "query": {
          "model": "Instance",
          "aggregate": "count",
          "where": {
            "environment": "production",
            "last_seen_at": {
              "gte": "$now-15m"
            }
          }
        },
        "link": {
          "model": "Instance",
          "filter": {
            "environment": "production"
          }
        }
      },
      {
        "key": "instances_active_24h",
        "title": "hub_fleet.kpi.active_24h",
        "kind": "stat",
        "query": {
          "model": "Instance",
          "aggregate": "count",
          "date_field": "last_seen_at",
          "range": "last_24_hours",
          "where": {
            "environment": "production"
          }
        },
        "compare": {
          "to": "previous_period"
        }
      }
    ]
  },
  "rbac": {
    "permissions": [
      {
        "key": "hub_fleet.instance.read",
        "models": [
          {
            "model": "Instance",
            "actions": [
              "index",
              "show"
            ]
          }
        ]
      },
      {
        "key": "hub_fleet.instance.retire",
        "models": [
          {
            "model": "Instance",
            "actions": [
              "retire"
            ]
          }
        ]
      }
    ],
    "roles": [
      {
        "key": "hub_fleet_operator",
        "label": "hub_fleet.role.operator",
        "permissions": [
          "hub_fleet.instance.read",
          "hub_fleet.instance.retire"
        ]
      }
    ]
  },
  "i18n": {
    "default_locale": "es-MX",
    "bundles": [
      {
        "locale": "es-MX",
        "path": "locales/es-MX.json"
      },
      {
        "locale": "en-US",
        "path": "locales/en-US.json"
      }
    ]
  },
  "connectors": [
    {
      "key": "trust_core",
      "label": "hub_fleet.connector.trust_core",
      "auth": "token",
      "credentials": [
        {
          "key": "base_url",
          "type": "string",
          "required": true,
          "validation": "^https://"
        },
        {
          "key": "signing_secret",
          "type": "secret",
          "required": true
        }
      ]
    },
    {
      "key": "fleet_feed",
      "label": "hub_fleet.connector.fleet_feed",
      "auth": "token",
      "credentials": [
        {
          "key": "signing_secret",
          "type": "secret",
          "required": true
        }
      ]
    }
  ],
  "webhooks": [
    {
      "key": "fleet_changes",
      "path": "/fleet/changes",
      "verify": "metacore-hmac-v1",
      "secret_ref": "fleet_feed.signing_secret",
      "do": "upsert:Instance"
    }
  ]
}