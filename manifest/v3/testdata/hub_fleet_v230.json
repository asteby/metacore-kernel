{
  "apiVersion": "asteby.com/v3",
  "kind": "Addon",
  "metadata": {
    "key": "hub_fleet",
    "name": "Hub Fleet",
    "description": "SPIKE (do not publish). Fleet of OPS instances seen by the Asteby Hub: deployment, channel, version, license state and brand, with filters and a revoke request that goes to the trust core.",
    "version": "0.2.0",
    "category": "vertical.hub",
    "icon": {
      "type": "lucide",
      "slug": "Server",
      "color": "#2563EB"
    },
    "author": "Asteby",
    "license": "UNLICENSED",
    "readme": "README.md",
    "visibility": "private",
    "owner": "asteby",
    "i18n": {
      "es": {
        "name": "Flota del Hub",
        "description": "SPIKE (no publicar). Flota de instancias OPS que ve el Hub de Asteby: despliegue, canal, versión, estado de licencia y marca, con filtros y una solicitud de revocación que va al núcleo de confianza."
      }
    }
  },
  "compatibility": {
    "requires": [
      {
        "key": "kernel",
        "version": ">=3.1.0 <4.0.0"
      }
    ],
    "provides": [
      "hub_fleet"
    ]
  },
  "tenancy": {
    "isolation": "shared",
    "rls_column": "organization_id"
  },
  "capabilities": [
    {
      "kind": "db:read",
      "target": "addon_hub_fleet.*",
      "reason": "Read the fleet replica (instances) of the organization."
    },
    {
      "kind": "db:write",
      "target": "addon_hub_fleet.*",
      "reason": "Keep the fleet replica (instances) of the organization."
    },
    {
      "kind": "http:fetch",
      "target": "connector:trust_core.base_url",
      "reason": "Pedir al nucleo de confianza la revocacion de una licencia."
    }
  ],
  "models": [
    {
      "key": "Instance",
      "table": "instances",
      "label": "hub_fleet.model.instance",
      "audit": true,
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "default": "gen_random_uuid()",
          "primary_key": true,
          "label": "hub_fleet.field.id",
          "visibility": "list"
        },
        {
          "name": "organization_id",
          "type": "uuid",
