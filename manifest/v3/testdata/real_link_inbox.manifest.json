        },
        {
          "name": "metadata",
          "type": "jsonb",
          "default": "{}",
          "label": "link_inbox.field.metadata"
        },
        {
          "name": "whatsapp_id",
          "type": "text",
          "readonly": true,
          "label": "link_inbox.field.whatsapp_id"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "not_null": true,
          "default": "now()",
          "label": "link_inbox.field.created_at"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "not_null": true,
          "default": "now()",
          "label": "link_inbox.field.updated_at"
        }
      ],
      "indices": [
        {
          "name": "messages_conversation_idx",
          "columns": [
            "conversation_id"
          ]
        },
        {
          "name": "messages_org_whatsapp_id_uq",
          "columns": [
            "organization_id",
            "whatsapp_id"
          ],
          "unique": true
        }
      ]
    }
  ],
  "frontend": {
    "entry": "/api/metacore/addons/link_inbox/frontend/dist/remoteEntry.js",
    "format": "federation",
    "expose": "./LinkInboxPanel",
    "container": "metacore_link_inbox",
    "layout": "immersive"
  },
  "contributions": {
    "navigation": [
      {
        "title": "link_inbox.nav.group",
        "icon": "MessagesSquare",
        "target": "sidebar.communication",
        "items": [
          {
            "title": "link_inbox.nav.chat",
            "icon": "MessagesSquare",
            "url": "addon://link_inbox/chat",
            "permission": "link_inbox.conversation.read"
          },
          {
            "title": "link_inbox.nav.inbox",
            "icon": "SquareKanban",
            "model": "Conversation",
            "view_type": "kanban",
            "group_by": "status",
            "permission": "link_inbox.conversation.read"
          },
          {
            "title": "link_inbox.nav.conversations",
            "icon": "MessageSquare",
            "model": "Conversation",
            "view_type": "table",
            "permission": "link_inbox.conversation.read"
          },
          {
            "title": "link_inbox.nav.contacts",
            "icon": "Users",
            "model": "Contact",
            "permission": "link_inbox.contact.read"
          },
          {
            "title": "link_inbox.nav.devices",
            "icon": "Smartphone",
            "model": "Device",
            "permission": "link_inbox.device.read"
          },
          {
            "title": "link_inbox.nav.messages",
            "icon": "Mail",
            "model": "Message",
            "permission": "link_inbox.message.read"
          }
        ]
      }
    ],
    "subscriptions": [
      {
        "event": "link_inbox.Message.created",
        "handler": {
          "type": "wasm",
          "function": "send_message"
        },
        "comment": "A message created with sender_type != contact (a human agent, bot or flow reply) is dispatched to the channel gateway. Inbound messages (sender_type=contact, written by ingest_message) are skipped so there is no echo loop."
      },
      {
        "event": "link_inbox.Device.deleted",
        "handler": {
          "type": "wasm",
          "function": "on_device_deleted"
        },
        "comment": "Soft-delete of a Device tears down the gateway Baileys session so WhatsApp stops delivering to a removed channel."
      },
      {
        "event": "quotes.quote_accepted",
        "handler": {
          "type": "wasm",
          "function": "on_quote_accepted"
        },
        "comment": "Optional bridge: when an accepted quote carries a conversation_id (created via create_quote_from_conversation), post a system message into that Conversation announcing the resulting sales order. A quote with no conversation_id (e.g. born elsewhere) is a clean no-op."
      },
      {
        "event": "connector_whatsapp.whatsapp.message.received",
        "handler": {
          "type": "wasm",
          "function": "ingest_whatsapp_event"
        },
        "comment": "WhatsApp messages from connector_whatsapp arrive straight on the event bus, replacing the signed /webhooks/incoming bridge for WhatsApp. ingest_whatsapp_event shares its ingestion core with ingest_message so both entrypoints agree on what ingesting a message means. The /webhooks/incoming path stays declared for any other channel gateway (web widget, Instagram, Telegram) still fronted by it."
      },
      {
        "event": "connector_whatsapp.whatsapp.connection.updated",
        "handler": {
          "type": "wasm",
          "function": "on_whatsapp_connection_event"
        },
        "comment": "Native event-plane sibling of the /webhooks/status HMAC callback (on_device_status), WhatsApp-specific. Shares applyDeviceStatus with on_device_status so both entrypoints agree on what a connection transition means for Device.status."
      },
      {
        "event": "connector_whatsapp.whatsapp.message.updated",
        "handler": {
          "type": "wasm",
          "function": "on_whatsapp_message_status"
        },
        "comment": "Delivery/read receipt from the WhatsApp native event plane. Annotates Message.delivery_status by whatsapp_id; a message this org never ingested is a clean no-op."
      },
      {
        "event": "connector_whatsapp.whatsapp.message.failed",
        "handler": {
          "type": "wasm",
          "function": "on_whatsapp_message_status"
        },
        "comment": "Outbound send failure from the WhatsApp native event plane. Same handler as message.updated — the payload's error field (vs. status) discriminates the two."
      }
    ],
    "notifications": [
      {
        "key": "inbound_message",
        "on": "link_inbox.Message.created",
        "when": {
          "after.sender_type": "contact"
        },
        "to": {
          "type": "org"
        },
        "exclude_actor": true,
        "title": "link_inbox.notification.new_message",
        "body": "{{after.content}}",
        "severity": "info",
        "icon": "message-circle",
        "link": "/addons/link_inbox/chat?c={{after.conversation_id}}",
        "comment": "Bell + toast (SSE). Query ?c= opens that conversation in the immersive chat."
      },
      {
        "key": "device_disconnected",
        "on": "link_inbox.Device.updated",
        "entered": {
          "field": "status",
          "values": [
            "disconnected",
            "error"
          ]
        },
        "to": {
          "type": "org"
        },
        "title": "link_inbox.notification.device_disconnected",
        "body": "{{after.name}} · {{after.disconnect_reason}}",
        "severity": "warning",
        "icon": "smartphone",
        "link": "/m/Device"
      }
    ],
    "actions": [
      {
        "key": "connect_device",
        "label": "link_inbox.action.connect_device",
        "icon": "QrCode",
        "target_model": "Device",
        "placement": "row",
        "handler": {
          "type": "wasm",
          "function": "connect_device"
        },
        "requires_state": [
          "disconnected",
          "error",
          "connecting"
        ],
        "modal": "link_inbox.connect_device"
      },
      {
        "key": "create_and_connect",
        "label": "link_inbox.action.create_and_connect",
        "icon": "QrCode",
        "target_model": "Device",
        "placement": "create",
        "handler": {
          "type": "wasm",
          "function": "connect_device"
        },
        "modal": "link_inbox.connect_device"
      },
      {
        "key": "link_customer",
        "label": "link_inbox.action.link_customer",
        "icon": "UserRoundPlus",
        "target_model": "Conversation",
        "placement": "row",
        "handler": {
          "type": "wasm",
          "function": "link_customer"
        },
        "fields": [
          {
            "key": "customer_id",
            "label": "link_inbox.action.link_customer.fields.customer",
            "type": "dynamic_select",
            "required": true,
            "ref": "Customer",
            "placeholder": "link_inbox.action.link_customer.fields.customer_placeholder"
          }
        ]
      },
      {
        "key": "create_quote_from_conversation",
        "label": "link_inbox.action.create_quote_from_conversation",
        "icon": "FileText",
        "target_model": "Conversation",
        "placement": "row",
        "handler": {
          "type": "wasm",
          "function": "create_quote_from_conversation"
        },
        "fields": [
          {
            "key": "note",
            "label": "link_inbox.action.create_quote_from_conversation.fields.note",
            "type": "string",
            "required": false,
            "widget": "textarea"
          }
        ]
      }
    ],
    "dashboard": [
      {
        "key": "open_conversations",
        "title": "link_inbox.widget.open_conversations",
        "subtitle": "link_inbox.widget.open_conversations_sub",
        "icon": "MessageSquare",
        "kind": "stat",
        "size": "sm",
        "group": "link_inbox.nav.group",
        "order": 10,
        "accent": "emerald",
        "format": "number",
        "permission": "link_inbox.conversation.read",
        "query": {
          "model": "Conversation",
          "aggregate": "count",
          "where": {
            "status": "abierto"
          }
        }
      },
      {
        "key": "conversations_by_status",
        "title": "link_inbox.widget.conversations_by_status",
        "subtitle": "link_inbox.widget.conversations_by_status_sub",
        "icon": "SquareKanban",
        "kind": "bar",
        "size": "md",
        "group": "link_inbox.nav.group",
        "order": 20,
        "accent": "sky",
        "format": "number",
        "permission": "link_inbox.conversation.read",
        "empty": "link_inbox.widget.conversations_by_status_empty",
        "query": {
          "model": "Conversation",
          "aggregate": "count",
          "group_by": "status",
          "label_field": "status",
          "order": "desc"
        }
      }
    ]
  },
