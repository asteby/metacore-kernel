  "contributions": {
    "navigation": [
      {
        "title": "mercadopago.nav.group",
        "icon": "CreditCard",
        "target": "sidebar.operations",
        "items": [
          {
            "title": "mercadopago.nav.payments",
            "icon": "CreditCard",
            "model": "MercadoPagoPayment",
            "permission": "mercadopago.mercadopagopayment.read"
          },
          {
            "title": "mercadopago.nav.refunds",
            "icon": "Undo2",
            "model": "MercadoPagoRefund",
            "permission": "mercadopago.mercadopagorefund.read"
          }
        ]
      }
    ],
    "actions": [
      {
        "key": "create_link",
        "label": "mercadopago.action.create_link.label",
        "icon": "Link",
        "target_model": "MercadoPagoPayment",
        "handler": {
          "type": "wasm",
          "function": "handle_MercadoPagoPayment_create_link"
        },
        "placement": "row"
      },
      {
        "key": "check_status",
        "label": "mercadopago.action.check_status.label",
        "icon": "RefreshCw",
        "target_model": "MercadoPagoPayment",
        "handler": {
          "type": "wasm",
          "function": "handle_MercadoPagoPayment_check_status"
        },
        "placement": "row"
      },
      {
        "key": "refund",
        "label": "mercadopago.action.refund.label",
        "icon": "Undo2",
        "target_model": "MercadoPagoPayment",
        "handler": {
          "type": "wasm",
          "function": "handle_MercadoPagoPayment_refund"
        },
        "placement": "row",
        "fields": [
          {
            "key": "amount",
            "label": "mercadopago.action.refund.amount",
            "type": "string",
            "required": false,
            "widget": "text",
            "placeholder": "mercadopago.action.refund.amount_placeholder"
          },
          {
            "key": "reason",
            "label": "mercadopago.action.refund.reason",
            "type": "string",
            "required": false,
            "widget": "text"
          }
        ],
        "requires_state": [
          "approved"
        ],
        "confirm": true,
        "confirm_message": "mercadopago.action.refund.confirm"
      }
    ]
  },
