{
  "apiVersion": "asteby.com/v3",
  "kind": "Addon",
  "metadata": {
    "key": "mercadopago",
    "name": "Mercado Pago",
    "description": "Mercado Pago for online stores and points of sale: Checkout Pro and Bricks with cards, interest-free installments (MSI), OXXO, SPEI and Mercado Crédito; signed webhooks, full and partial refunds, sandbox mode; plus Point card terminals through a store-local edge agent.",
    "version": "0.15.11",
    "category": "integration.payments",
    "icon": {
      "type": "svg",
      "slug": "assets/logo.svg",
      "color": "#00B1EA"
    },
    "author": "Asteby",
    "license": "Apache-2.0",
    "website": "https://www.mercadopago.com.mx/developers",
    "readme": "README.md",
    "i18n": {
      "es": {
        "name": "Mercado Pago",
        "description": "Cobra en tu tienda en línea y en mostrador con Mercado Pago: Checkout Pro o Bricks integrados con tarjetas, meses sin intereses, OXXO, SPEI y Mercado Crédito; webhooks firmados, reembolsos totales y parciales y modo de pruebas. Incluye terminales Point para el punto de venta.",
        "features": [
          "Checkout Pro (redirección) y Payment Brick integrado en tu tienda",
          "Pago integrado en la página: tarjeta con Payment Brick y efectivo (OXXO, 7 Eleven, Circle K, Soriana, STP) sin salir de la tienda",
          "Tarjetas de crédito y débito con hasta 12 meses sin intereses",
          "Efectivo en OXXO, transferencia SPEI y Mercado Crédito",
          "Capacidades commerce.payments: sesión, confirmación y reembolso",
          "Webhooks verificados con x-signature; el pago siempre se consulta en Mercado Pago",
          "Reembolsos totales y parciales sin cobros duplicados (idempotencia)",
          "Modo sandbox con usuarios de prueba y ajustes por mercado",
          "Terminales Point para el punto de venta"
        ]
      },
      "en": {
        "name": "Mercado Pago",
        "description": "Get paid online and in store with Mercado Pago: Checkout Pro or embedded Bricks with cards, interest-free installments, OXXO, SPEI and Mercado Crédito; signed webhooks, full and partial refunds and sandbox mode. Includes Point terminals for the point of sale.",
        "features": [
          "Checkout Pro (redirect) and embedded Payment Brick",
          "Payment inside the store page: card with the Payment Brick and cash (OXXO, 7 Eleven, Circle K, Soriana, STP) without leaving the store",
          "Cards with up to 12 interest-free installments (MSI per account promotions)",
          "OXXO cash, SPEI bank transfer and Mercado Crédito",
          "commerce.payments session, confirm and refund capabilities for the storefront",
          "Webhooks verified with x-signature; payment always re-read from the Mercado Pago API",
          "Full and partial refunds with idempotency keys",
          "Sandbox with test users, per-market settings",
          "Point card terminals for the POS"
        ]
      }
    },
    "countries": [
      "MX",
      "AR",
      "BR",
      "CL",
      "CO",
      "PE",
      "UY"
    ],
    "features": [
      "Checkout Pro (redirect) and embedded Payment Brick",
      "Payment inside the store page: card with the Payment Brick and cash (OXXO, 7 Eleven, Circle K, Soriana, STP) without leaving the store",
      "Cards with up to 12 interest-free installments (MSI per account promotions)",
      "OXXO cash, SPEI bank transfer and Mercado Crédito",
      "commerce.payments session, confirm and refund capabilities for the storefront",
      "Webhooks verified with x-signature; payment always re-read from the Mercado Pago API",
      "Full and partial refunds with idempotency keys",
      "Sandbox with test users, per-market settings",
      "Point card terminals for the POS"
    ]
  },
  "compatibility": {
    "requires": [
      {
        "key": "kernel",
        "version": ">=3.0.0 <4.0.0"
      },
      {
        "key": "customers",
        "version": ">=0.1.0",
        "optional": true,
        "reason": "Recommended: payments reference SalesOrder. With caja, settlements liquidate pending_payment orders."
      },
      {
        "key": "caja",
        "version": ">=0.2.0",
        "optional": true,
        "reason": "Recommended: caja listens to payment_confirmed / point_payment_approved to settle the queue."
      }
    ]
  },
  "tenancy": {
    "isolation": "shared",
    "rls_column": "organization_id"
  },
  "capabilities": [
    {
      "kind": "db:write",
      "target": "addon_mercadopago.*",
      "reason": "Persist Mercado Pago payments and their status."
    },
    {
      "kind": "db:read",
      "target": "addon_mercadopago.*",
      "reason": "Read payments for screens and reconciliation."
    },
    {
      "kind": "http:fetch",
      "target": "api.mercadopago.com",
      "reason": "Create Checkout Pro preferences and Bricks payments, read and search payments, and issue refunds against the Mercado Pago API."
    },
    {
      "kind": "http:fetch",
      "target": "connector:mercadopago.api_base",
      "reason": "Sandbox / test only: reach the local payment simulator (tools/payment-sim) when the connector sets api_base. Ignored and rejected with production credentials."
    },
    {
      "kind": "connector:read",
      "target": "mercadopago",
      "reason": "Read the org's Mercado Pago credentials (access token, public key, webhook secret) to call the API and verify notifications."
    },
    {
      "kind": "event:emit",
      "target": "mercadopago.payment_confirmed",
      "reason": "Notify POS/kiosk when a payment is confirmed approved at Mercado Pago."
    },
    {
      "kind": "event:emit",
      "target": "mercadopago.point_payment_approved",
      "reason": "Notify POS/kiosk when a Point terminal approves a card payment."
    },
    {
      "kind": "event:emit",
      "target": "mercadopago.payment_updated",
      "reason": "Tell the storefront cart and OPS that an online payment changed status (paid, failed, refunded), after re-reading it from the Mercado Pago API."
    },
    {
      "kind": "event:emit",
      "target": "commerce.payments.confirmed",
      "reason": "Neutral contract event of the commerce.payments family, {provider, result}: tells the storefront cart that a payment changed, in the commerce.payments.confirm shape, so the cart does not have to name this provider or wait for its poll. Only a signal: the cart re-reads the payment with commerce.payments.status before acting."
    },
    {
      "kind": "event:emit",
      "target": "mercadopago.refund_created",
      "reason": "Tell OPS a refund was issued at Mercado Pago so returns and accounting can reconcile it."
    },
    {
      "kind": "event:emit",
      "target": "mercadopago.webhook_signature_invalid",
      "reason": "Signal for OPS to open the «update the webhook secret» incident: a notification arrived whose x-signature did not verify. Carries only a reason code, counts and the payment id the notification points at; never a secret or a hash."
    },
    {
      "kind": "event:emit",
      "target": "mercadopago.payment_write_failed",
      "reason": "Signal for OPS to open the «payment not recorded» incident: a payment taken by commerce.payments.submit (it exists at Mercado Pago and was answered to the store) could not be written to the local ledger after a retry. Carries ids, status and the host's refusal cause; never a card token, a secret or personal data."
    }
  ],
