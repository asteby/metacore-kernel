        "key": "mercadopago_manager",
        "label": "mercadopago.role.manager",
        "description": "Manage Mercado Pago payments and connector.",
        "permissions": [
          "mercadopago.mercadopagopayment.read",
          "mercadopago.mercadopagopayment.write",
          "mercadopago.mercadopagorefund.read",
          "mercadopago.mercadopagorefund.write",
          "mercadopago.mercadopagopayment.refund"
        ]
      }
    ]
  },
  "edge_devices": [
    {
      "key": "mp_point",
      "label": "mercadopago.device.point.label",
      "kind": "card_terminal",
      "capabilities": [
        "card_payment"
      ],
      "transport": "ws",
      "heartbeat_interval_seconds": 20,
      "form_layout": {
        "mode": "sections",
        "sections": [
          {
            "key": "pairing",
            "title": "mercadopago.device.point.section.pairing"
          }
        ]
      },
      "pairing_credentials": [
        {
          "key": "branch_id",
          "type": "string",
          "label": "mercadopago.device.point.field.branch",
          "required": true,
          "section": "pairing"
        },
        {
          "key": "terminal_id",
          "type": "string",
          "label": "mercadopago.device.point.field.terminal",
          "required": true,
          "section": "pairing",
          "description": "mercadopago.device.point.help.terminal"
        },
        {
          "key": "pairing_pin",
          "type": "secret",
          "label": "mercadopago.device.point.field.pin",
          "required": true,
          "section": "pairing"
        }
      ],
      "events": [
        {
          "type": "payment.approved",
          "do": "wasm:on_point_payment_approved",
          "idempotent": true
        },
        {
          "type": "payment.rejected",
          "do": "wasm:on_point_payment_rejected",
          "idempotent": true
        },
        {
          "type": "device.error",
          "do": "wasm:on_point_device_error"
        },
        {
          "type": "device.offline",
          "do": "wasm:on_point_device_offline"
        }
      ],
      "commands": [
        {
          "type": "create_payment_intent",
          "timeout_seconds": 10
        },
        {
          "type": "cancel_payment_intent",
          "timeout_seconds": 5
        }
      ]
    }
  ],
  "extension_points": {
    "events": [
      {
        "name": "mercadopago.payment_confirmed",
        "description": "Online payment confirmed approved. payload: organization_id, payment_id, sale_id, reference, checkout_id, amount, currency_code, mp_payment_id, occurred_at, plus amount_matches (true/false; null when no expected amount is known), expected_amount and expected_currency_code. The expected amount is the order total the submit charged for or, for Checkout Pro, the amount recorded when the preference was created (it can be stale if the cart changed after that preference); a signal for auditing, the event is emitted the same either way."
      },
      {
        "name": "mercadopago.point_payment_approved",
        "description": "Point terminal approved a card payment (store-local edge device, or an Orders API order: payload.external_reference, payment_id = order id, amount, currency_code)."
      },
      {
        "name": "mercadopago.payment_updated",
        "description": "Online payment status changed (payload.payment uses the commerce.payments.confirm output shape: order_ref, status, amount, currency, provider_ref, event_id)."
      },
      {
        "name": "mercadopago.refund_created",
        "description": "Refund issued at Mercado Pago (payload.refund uses the commerce.payments.refund output shape; provider_ref and order_ref sit beside it)."
      },
      {
        "name": "mercadopago.webhook_signature_invalid",
        "description": "A Mercado Pago notification arrived with an x-signature that did not verify. It was used as a hint (the payment was read from the API by id), not trusted. payload: organization_id, resource_id, reason (a code), cause (secret_not_configured: require_webhook_signature is on and the connector has no webhook key; signature_missing; signature_invalid: a key was tried and did not verify), secret_configured, keys_tried, reconciled, outcome."
      },
      {
        "name": "mercadopago.payment_write_failed",
        "description": "A payment taken by commerce.payments.submit could not be written to mp_payments (after one retry). The payment is safe at Mercado Pago; the webhook and the sweeper bring the row in line. payload: provider_ref, order_ref, checkout_id, status, source, essential, write_failures [{table,row,cause}], occurred_at."
      }
    ]
  }
}
