{
  "description": "map con image_field (logo por punto) y color_field (color de marca) desde la fuente.",
  "input": {
    "version": "genui/v2",
    "data": {
      "points": {
        "q": "t:hub.Instance?limit=200"
      }
    },
    "blocks": [
      {
        "type": "map",
        "summary": "Instancias",
        "source": "data.points",
        "fields": {
          "key": "id",
          "lat": "lat",
          "lng": "lng",
          "label": "name"
        },
        "image_field": "brand_logo_url",
        "color_field": "brand_primary_color"
      }
    ]
  },
  "expect": {
    "ok": true
  }
}
