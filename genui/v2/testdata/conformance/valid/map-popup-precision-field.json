{
  "description": "map con popup, precision_field y area_field por fila.",
  "input": {
    "version": "genui/v2",
    "data": {
      "points": {
        "q": "t:hub.Instance?limit=200"
      }
    },
    "blocks": [
      {
        "type": "map",
        "summary": "Instancias",
        "source": "data.points",
        "fields": {
          "key": "id",
          "lat": "lat",
          "lng": "lng",
          "label": "name"
        },
        "popup": [
          "name",
          "country_iso",
          "status"
        ],
        "precision_field": "precision",
        "area_field": "country_iso"
      }
    ]
  },
  "expect": {
    "ok": true
  }
}
